# Environment
NODE_ENV="production"
APP_PORT="3141"
APP_MODULE="auth"

# App
APP_URL="http://localhost:3141"
APP_ORIGINS="http://localhost:3141"

# Database
DB_URL="mongodb+srv://<username>:<password>@<remaining URI>"
DB_NAME="vibe"
MONGOMS_DEBUG="true"

# ─────────────────────────────────────────────────────────────────────
# Firebase Auth — production mode (default)
#
# The default `FIREBASE_PROJECT_ID` below is the real production project
# (`vibe-shash`). When set, the backend's Firebase Admin SDK talks to the
# real Firebase project, and the JS SDK in `frontend/src/lib/firebase.ts`
# uses the corresponding `VITE_FIREBASE_*` config to authenticate against
# the same project.
#
# Emulator mode (dev/demo only, NOT for production deploys):
#   1. Run `firebase emulators:start --only auth --project demo-test`
#      (the seed script `backend/scripts/seed-discussion-demo.cjs`
#      expects exactly this project id).
#   2. Uncomment / set:
#        FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
#        FIREBASE_AUTH_EMULATOR_HOST_FORCE=true
#        FIREBASE_PROJECT_ID="demo-test"
#        GCLOUD_PROJECT="demo-test"
#      so the Admin SDK matches the emulator's audience claim.
#   3. In `frontend/.env`, set:
#        VITE_USE_FIREBASE_EMULATOR=true
#        VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#      so the JS SDK is also pointed at the emulator.
#
# Without step 3, the JS SDK still hits the real Firebase project even
# though the Admin SDK is pointed at the emulator — tokens will fail
# audience-claim verification. Without step 2, the Admin SDK rejects
# tokens issued by the emulator for the same reason.
# ─────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID="vibe-shash"

# Emulator defaults — OPT IN for local dev/demo. Leave commented (or
# delete) for production deploys.
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIREBASE_AUTH_EMULATOR_HOST_FORCE=true
# GCLOUD_PROJECT="demo-test"

# Firestore emulator — OPT IN. Used only by tooling scripts.
# FIREBASE_EMULATOR_HOST="127.0.0.1:4000"

# ── Crowd-question screening filter (studentQuestions) ──
# Provider for the AI screening judge: 'groq' (free-tier demo) or 'anthropic' (prod).
SCREENING_PROVIDER=groq
SCREENING_ENABLED=true
# Context (lesson-relevance) checking — ON HOLD until real transcripts exist.
# When true, feeds lesson context to the on-topic gate + answer-correctness check.
SCREENING_CONTEXT_ENABLED=false
# Groq (free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic (prod) reuses ANTHROPIC_CRED / ANTHROPIC_MODEL above.
SCREENING_TIMEOUT_MS=9000
SCREENING_MAX_RETRIES=2
SCREENING_DEDUP_LIMIT=50
SCREENING_CONTEXT_CHARS=2000
